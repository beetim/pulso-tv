<resources>

    <!-- Every screen is Compose: the theme only paints the window behind it. -->
    <style name="DarkTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulsoBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

</resources>
